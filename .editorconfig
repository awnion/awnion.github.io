# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # two trailing spaces = <br> in markdown

[*.{yml,yaml}]
indent_size = 2

[*.{toml,json}]
indent_size = 2

[*.sh]
indent_size = 2
end_of_line = lf

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
